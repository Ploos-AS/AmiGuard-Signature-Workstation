{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ploos.no/schemas/asw-evidence-envelope-1.json",
  "title": "ASW Core evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform", "namespace", "sample", "producer", "evidence", "analysis_started"],
  "properties": {
    "schema": {"const": "asw.core.evidence/1"},
    "platform": {"type": "string", "minLength": 1, "maxLength": 64},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 64},
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "revision"],
      "properties": {
        "kind": {"enum": ["runtime-backend", "forensic-interpreter", "static-analyzer", "core"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256", "size"],
        "properties": {
          "role": {"type": "string", "minLength": 1, "maxLength": 128},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "analysis_started": {"const": false}
  }
}
